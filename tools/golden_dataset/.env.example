# Copy to .env in the repository root. Existing environment variables take precedence.
GOLDEN_BASE_URL=http://localhost:8001/v1
GOLDEN_API_KEY=
GOLDEN_GENERATOR_MODEL=your-generator-model
GOLDEN_REVIEWER_MODEL=your-reviewer-model

GOLDEN_OUTPUT_TOKENS=4096
GOLDEN_TIMEOUT_SECONDS=120
GOLDEN_RETRIES=3
GOLDEN_AGENT_STEPS=5

# Optional cumulative run budgets; blank means unlimited.
GOLDEN_MAX_TOKENS=
GOLDEN_MAX_COST=

# Required for cost budgets. Prices are currency units per million tokens.
GOLDEN_GENERATOR_INPUT_PER_MILLION=
GOLDEN_GENERATOR_OUTPUT_PER_MILLION=
GOLDEN_REVIEWER_INPUT_PER_MILLION=
GOLDEN_REVIEWER_OUTPUT_PER_MILLION=

# Optional provider-specific Chat Completions options (JSON object).
# To use max_completion_tokens instead, specify it here; it replaces max_tokens.
GOLDEN_PARAMETERS={}
